import Metal.S06_SymExec

/-!
# Lab statement — FROZEN

**Do not edit this file.** Its SHA-256 is pinned in `Lab/guard.json`, and
`tools/proof_guard.py` rejects any change. This is the only part of the
lab a human has to read and trust: the program, the reference function,
and the theorem statement. Everything in `Lab/Proof.lean` is untrusted.

The task: prove that clang's `count_zeros` (see `c/examples.c`), compiled to
RISC-V and run by our process model, exits with exactly the number of zero
bytes in its input (mod 2^32), for every input below 64 MiB.
-/

namespace Lab
open Metal Reg Instr

/-- `count_zeros` from `clang --target=riscv32-unknown-elf -march=rv32i -O1`,
    behind the usual `_start` stub. -/
def czProg : Program := ⟨[
  /- 0x00 _start: -/ jal ra 12,
  /- 0x04 -/         li a7 93,
  /- 0x08 -/         ecall,
  /- 0x0c count_zeros: -/ li a2 0,
  /- 0x10 -/         beqz a1 28,         -- → .LBB0_3 (0x2c)
  /- 0x14 -/         add a1 a0 a1,
  /- 0x18 .LBB0_2: -/ lbu a3 a0 0,
  /- 0x1c -/         seqz a3 a3,
  /- 0x20 -/         addi a0 a0 1,
  /- 0x24 -/         add a2 a2 a3,
  /- 0x28 -/         bne a0 a1 (-16),    -- → .LBB0_2 (0x18)
  /- 0x2c .LBB0_3: -/ mv a0 a2,
  /- 0x30 -/         ret
]⟩

/-- The reference: how many bytes are zero, as a 32-bit word. -/
def countZeros (input : List Byte) : Word :=
  BitVec.ofNat 32 (input.countP (· = 0))

/-- **The statement.** -/
def Statement : Prop :=
  ∀ input : List Byte, input.length < maxInput →
    ExitsWith czProg (load input) (countZeros input)

end Lab
